From: ViKing <viking.yfy@qq.com>
Subject: [PATCH] wifi: ath12k: coordinate mixed-bus group shutdown

PCI shutdown walks every device in an MLO hardware group. On BE6500 this
includes IPQ5332 AHB state, which cannot be passed to the PCI power-down
routine. Quiesce shared DMA and submit MLO teardown to all partners. Wait
for bounded completion ACKs before destroying radios or stopping WMI.
Use each device's HIF callback and make group power-down idempotent.

Validate completion TLV size, correlate pdev and retain firmware status.
Report teardown timeout or firmware errors. Preserve
the local PCI fallback when the group was not initialized or QMI failed.

Signed-off-by: ViKing <viking.yfy@qq.com>
---
--- a/drivers/net/wireless/ath/ath12k/core.c
+++ b/drivers/net/wireless/ath/ath12k/core.c
@@ -1093,6 +1093,8 @@ static void ath12k_core_hw_group_stop(st
 
 	clear_bit(ATH12K_GROUP_FLAG_REGISTERED, &ag->flags);
 	ath12k_dp_ds_stop_group(ag);
+	/* Keep every partner and its WMI event path live until teardown ACKs. */
+	ath12k_mac_mlo_teardown(ag);
 
 	for (i = ag->num_devices - 1; i >= 0; i--) {
 		ab = ag->ab[i];
@@ -1107,9 +1109,6 @@ static void ath12k_core_hw_group_stop(st
 	/* Unregister MAC (drops wiphys) only after per-device cleanup */
 	ath12k_mac_unregister(ag);
 
-	/* Teardown MLO state after MAC unregister for symmetry */
-	ath12k_mac_mlo_teardown(ag);
-
 	ath12k_mac_destroy(ag);
 }
 
--- a/drivers/net/wireless/ath/ath12k/core.h
+++ b/drivers/net/wireless/ath/ath12k/core.h
@@ -268,6 +268,7 @@ enum ath12k_hw_group_flags {
 	ATH12K_GROUP_FLAG_REGISTERED,
 	ATH12K_GROUP_FLAG_UNREGISTER,
 	ATH12K_GROUP_FLAG_DS_QUARANTINED,
+	ATH12K_GROUP_FLAG_SHUTDOWN,
 };
 
 enum ath12k_dev_flags {
@@ -770,6 +771,9 @@ struct ath12k {
 
 	struct completion mlo_setup_done;
 	u32 mlo_setup_status;
+	struct completion mlo_teardown_done;
+	u32 mlo_teardown_status;
+	bool mlo_teardown_pending;
 	u8 ftm_msgref;
 	struct ath12k_fw_stats fw_stats;
 	unsigned long last_tx_power_update;
--- a/drivers/net/wireless/ath/ath12k/mac.c
+++ b/drivers/net/wireless/ath/ath12k/mac.c
@@ -15439,6 +15439,7 @@ static void ath12k_mac_setup(struct ath1
 	init_completion(&ar->scan.completed);
 	init_completion(&ar->scan.on_channel);
 	init_completion(&ar->mlo_setup_done);
+	init_completion(&ar->mlo_teardown_done);
 	init_completion(&ar->completed_11d_scan);
 	init_completion(&ar->regd_update_completed);
 	init_completion(&ar->thermal.wmi_sync);
@@ -15545,8 +15546,12 @@ static int __ath12k_mac_mlo_teardown(str
 	if (num_link == 0)
 		return 0;
 
+	reinit_completion(&ar->mlo_teardown_done);
+	WRITE_ONCE(ar->mlo_teardown_status, 0);
+	WRITE_ONCE(ar->mlo_teardown_pending, true);
 	ret = ath12k_wmi_mlo_teardown(ar);
 	if (ret) {
+		WRITE_ONCE(ar->mlo_teardown_pending, false);
 		ath12k_warn(ab, "failed to send MLO teardown WMI command for pdev %d: %d\n",
 			    ar->pdev_idx, ret);
 		return ret;
@@ -15603,20 +15608,42 @@ void ath12k_mac_mlo_teardown(struct ath1
 {
 	struct ath12k_hw *ah;
 	struct ath12k *ar;
+	unsigned long time_left;
+	u32 status;
 	int ret, i, j;
 
+	lockdep_assert_held(&ag->mutex);
+
+	/* Submit to all partners before waiting; the firmware may coordinate ACKs. */
 	for (i = 0; i < ag->num_hw; i++) {
 		ah = ag->ah[i];
 		if (!ah)
 			continue;
 
 		for_each_ar(ah, ar, j) {
-			ar = &ah->radio[j];
+			WRITE_ONCE(ar->mlo_teardown_pending, false);
 			ret = __ath12k_mac_mlo_teardown(ar);
-			if (ret) {
-				ath12k_err(ar->ab, "failed to teardown MLO: %d\n", ret);
-				break;
-			}
+			if (ret)
+				ath12k_warn(ar->ab, "MLO teardown submit pdev:%d error:%d\n",
+					    ar->pdev_idx, ret);
+		}
+	}
+
+	for (i = 0; i < ag->num_hw; i++) {
+		ah = ag->ah[i];
+		if (!ah)
+			continue;
+
+		for_each_ar(ah, ar, j) {
+			if (!READ_ONCE(ar->mlo_teardown_pending))
+				continue;
+			time_left = wait_for_completion_timeout(&ar->mlo_teardown_done,
+								WMI_MLO_CMD_TIMEOUT_HZ);
+			status = READ_ONCE(ar->mlo_teardown_status);
+			WRITE_ONCE(ar->mlo_teardown_pending, false);
+			if (!time_left || status)
+				ath12k_warn(ar->ab, "MLO teardown pdev:%d timeout:%u status:%u\n",
+					    ar->pdev_idx, !time_left, status);
 		}
 	}
 }
--- a/drivers/net/wireless/ath/ath12k/pci.c
+++ b/drivers/net/wireless/ath/ath12k/pci.c
@@ -1746,16 +1746,25 @@ static void ath12k_pci_hw_group_power_do
 	if (!ag)
 		return;
 
+	/* Stop shared DMA and detach MLO before any partner loses WMI. */
+	if (test_bit(ATH12K_GROUP_FLAG_REGISTERED, &ag->flags))
+		ath12k_core_hw_group_cleanup(ag);
+
 	mutex_lock(&ag->mutex);
+	if (test_and_set_bit(ATH12K_GROUP_FLAG_SHUTDOWN, &ag->flags))
+		goto unlock;
 
+	ath12k_dp_ds_stop_group(ag);
 	for (i = 0; i < ag->num_devices; i++) {
 		ab = ag->ab[i];
 		if (!ab)
 			continue;
 
-		ath12k_pci_power_down(ab, false);
+		/* Mixed groups include AHB devices; never cast them to PCI state. */
+		ath12k_hif_power_down(ab, false);
 	}
 
+unlock:
 	mutex_unlock(&ag->mutex);
 }
 
@@ -1765,6 +1774,10 @@ static void ath12k_pci_shutdown(struct p
 	struct ath12k_pci *ab_pci = ath12k_pci_priv(ab);
 
 	ath12k_pci_set_irq_affinity_hint(ab_pci, NULL);
+	if (!ab->ag || test_bit(ATH12K_FLAG_QMI_FAIL, &ab->dev_flags)) {
+		ath12k_pci_power_down(ab, false);
+		return;
+	}
 	ath12k_pci_hw_group_power_down(ab->ag);
 }
 
--- a/drivers/net/wireless/ath/ath12k/wmi.c
+++ b/drivers/net/wireless/ath/ath12k/wmi.c
@@ -9955,8 +9955,10 @@ static void ath12k_wmi_event_teardown_co
 					       struct sk_buff *skb)
 {
 	const struct wmi_mlo_teardown_complete_event *ev;
+	struct ath12k *ar;
 	const void **tb;
-	int ret;
+	u32 pdev_id;
+	int ret, i;
 
 	tb = ath12k_wmi_tlv_parse(ab, skb);
 	if (IS_ERR(tb)) {
@@ -9966,8 +9968,24 @@ static void ath12k_wmi_event_teardown_co
 	}
 
 	ev = tb[WMI_TAG_MLO_TEARDOWN_COMPLETE];
-	if (!ev)
-		ath12k_warn(ab, "failed to fetch teardown complete event\n");
+	if (!ev || ath12k_wmi_tlv_data_len(ev) < sizeof(*ev)) {
+		ath12k_warn(ab, "missing or truncated MLO teardown complete event\n");
+		return;
+	}
+
+	pdev_id = le32_to_cpu(ev->pdev_id);
+	for (i = 0; i < ab->num_radios; i++) {
+		if (ab->pdevs[i].pdev_id != pdev_id)
+			continue;
+		ar = ab->pdevs[i].ar;
+		if (!ar || !READ_ONCE(ar->mlo_teardown_pending))
+			return;
+		WRITE_ONCE(ar->mlo_teardown_status, le32_to_cpu(ev->status));
+		complete(&ar->mlo_teardown_done);
+		return;
+	}
+
+	ath12k_warn(ab, "invalid pdev_id %u in MLO teardown complete event\n", pdev_id);
 }
 
 #ifdef CPTCFG_ATH12K_DEBUGFS
@@ -11825,7 +11843,7 @@ int ath12k_wmi_mlo_teardown(struct ath12
 	cmd->tlv_header = ath12k_wmi_tlv_cmd_hdr(WMI_TAG_MLO_TEARDOWN_CMD,
 						 sizeof(*cmd));
 	cmd->pdev_id = cpu_to_le32(ar->pdev->pdev_id);
-	cmd->reason_code = WMI_MLO_TEARDOWN_SSR_REASON;
+	cmd->reason_code = cpu_to_le32(WMI_MLO_TEARDOWN_SSR_REASON);
 
 	ret = ath12k_wmi_cmd_send(wmi, skb, WMI_MLO_TEARDOWN_CMDID);
 	if (ret) {
