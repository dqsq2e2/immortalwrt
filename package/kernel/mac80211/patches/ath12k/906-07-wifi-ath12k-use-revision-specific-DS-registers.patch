From: ViKing <viking.yfy@qq.com>
Date: Sat, 24 Oct 2026 22:28:52 +0800
Subject: [PATCH] wifi: ath12k: use QCN9274 revision specific DS registers

The QCN9274 hw1.0 REO2PPE ring starts at 0x91c, while hw2.0 uses 0x938.
The native Direct Switch client previously used the hw2.0 constant for
both revisions, leaving the real hw1.0 receive ring unconfigured.
REO2PPE_DEST_INFO at 0xcf0 also exists only in hw2.0.

Select these offsets through the existing hardware register tables and
skip the absent register on hw1.0. TCL/VP and producer index registers
are shared by both revisions. No board or host SoC special case is
needed, and the established hw2.0 path keeps its existing values.

Link: https://android.googlesource.com/kernel/msm-modules/wlan-fw-api/+/9ab723333db68e4552672f9e2a5cc6f8e4027894/hw/qcn9224/
Signed-off-by: ViKing <viking.yfy@qq.com>
---
--- a/drivers/net/wireless/ath/ath12k/hal.h
+++ b/drivers/net/wireless/ath/ath12k/hal.h
@@ -1209,6 +1209,8 @@ struct ath12k_hw_regs {
 	u32 reo_cmd_ring_base;
 
 	u32 reo_status_ring_base;
+	u32 reo2ppe_ring_base;
+	u32 reo2ppe_dest_info;
 
 	u32 gcc_gcc_pcie_hot_rst;
 
--- a/drivers/net/wireless/ath/ath12k/wifi7/hal.h
+++ b/drivers/net/wireless/ath/ath12k/wifi7/hal.h
@@ -196,10 +196,10 @@
 #define HAL_REO_STATUS_HP			0x000030a8
 
 /* REO direct-switch ring on QCN9274. */
-#define HAL_REO2PPE_RING_BASE_LSB		0x00000938
+#define HAL_REO2PPE_RING_BASE_LSB(hal)	((hal)->regs->reo2ppe_ring_base)
 #define HAL_REO2PPE_RING_HP			0x00003090
 #define HAL_REO2PPE_RING_MAX_SIZE		0x000fffff
-#define HAL_REO2PPE_DEST_INFO			0x00000cf0
+#define HAL_REO2PPE_DEST_INFO(hal)	((hal)->regs->reo2ppe_dest_info)
 #define HAL_REO2PPE_DEST_INFO_VALUE		0x00002000
 
 #define HAL_WBM2SW_DS_RING_NUM			6
--- a/drivers/net/wireless/ath/ath12k/wifi7/hal_qcn9274.c
+++ b/drivers/net/wireless/ath/ath12k/wifi7/hal_qcn9274.c
@@ -297,6 +297,7 @@ const struct ath12k_hw_regs qcn9274_v1_r
 
 	/* REO status ring address */
 	.reo_status_ring_base = 0x00000a84,
+	.reo2ppe_ring_base = 0x0000091c,
 
 	/* CE base address */
 	.umac_ce0_src_reg_base = 0x01b80000,
@@ -392,6 +393,8 @@ const struct ath12k_hw_regs qcn9274_v2_r
 
 	/* REO status ring address */
 	.reo_status_ring_base = 0x00000aa0,
+	.reo2ppe_ring_base = 0x00000938,
+	.reo2ppe_dest_info = 0x00000cf0,
 
 	/* CE base address */
 	.umac_ce0_src_reg_base = 0x01b80000,
@@ -1022,7 +1025,7 @@ static int ath12k_hal_srng_create_config
 	s->reg_start[1] = HAL_SEQ_WCSS_UMAC_REO_REG + HAL_REO_STATUS_HP;
 
 	s = &hal->srng_config[HAL_REO2PPE];
-	s->reg_start[0] = HAL_SEQ_WCSS_UMAC_REO_REG + HAL_REO2PPE_RING_BASE_LSB;
+	s->reg_start[0] = HAL_SEQ_WCSS_UMAC_REO_REG + HAL_REO2PPE_RING_BASE_LSB(hal);
 	s->reg_start[1] = HAL_SEQ_WCSS_UMAC_REO_REG + HAL_REO2PPE_RING_HP;
 
 	s = &hal->srng_config[HAL_TCL_DATA];
--- a/drivers/net/wireless/ath/ath12k/wifi7/ppe_ds.c
+++ b/drivers/net/wireless/ath/ath12k/wifi7/ppe_ds.c
@@ -664,8 +664,11 @@ static int ath12k_ds_start(struct ath12k
 	ret = ath12k_dp_rx_htt_ds_cfg(ab);
 	if (ret)
 		return ret;
-	ath12k_hif_write32(ab, HAL_SEQ_WCSS_UMAC_REO_REG + HAL_REO2PPE_DEST_INFO,
-			   HAL_REO2PPE_DEST_INFO_VALUE);
+	/* REO2PPE_DEST_INFO was added in QCN9274 hw2.0. */
+	if (HAL_REO2PPE_DEST_INFO(&ab->hal))
+		ath12k_hif_write32(ab, HAL_SEQ_WCSS_UMAC_REO_REG +
+				   HAL_REO2PPE_DEST_INFO(&ab->hal),
+				   HAL_REO2PPE_DEST_INFO_VALUE);
 	reg = HAL_SEQ_WCSS_UMAC_TCL_REG + HAL_TCL_DS_RBM_MAPPING_OFFSET;
 	val = ath12k_hif_read32(ab, reg);
 	val &= ~GENMASK(31, HAL_TCL_DS_RBM_MAPPING_SHIFT);
