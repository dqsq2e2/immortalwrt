From: JiaY-shi <shi05275@163.com>
Subject: [PATCH] wifi: ath12k: validate MLO peer kickout events

Validate both link maps and the current mac80211 link address before
reporting low ACK. Cross-check a datapath peer, when present, against
the control-plane station, vdev and link. Keep legacy address checks
and the existing reason-specific event handling.

Signed-off-by: JiaY-shi <shi05275@163.com>
Signed-off-by: ViKing <viking.yfy@qq.com>
---
--- a/drivers/net/wireless/ath/ath12k/wmi.c
+++ b/drivers/net/wireless/ath/ath12k/wmi.c
@@ -7614,9 +7614,16 @@ static void ath12k_peer_sta_kickout_even
 	struct wmi_peer_sta_kickout_arg arg = {};
 	struct ath12k_link_vif *arvif;
 	struct ieee80211_sta *sta;
+	struct ieee80211_link_sta *link_sta;
+	struct ieee80211_sta *dp_sta = NULL;
+	struct ath12k_dp_link_peer *dp_peer;
+	struct ath12k_dp *dp = ath12k_ab_to_dp(ab);
 	struct ath12k_sta *ahsta;
 	struct ath12k_link_sta *arsta;
 	struct ath12k *ar;
+	int dp_vdev_id = -1, dp_peer_id = -1;
+	u8 dp_link_id = ATH12K_INVALID_LINK_ID;
+	bool dp_mlo = false, dp_peer_valid = false;
 
 	if (ath12k_pull_peer_sta_kickout_ev(ab, skb, &arg) != 0) {
 		ath12k_warn(ab, "failed to extract peer sta kickout event");
@@ -7625,6 +7632,18 @@ static void ath12k_peer_sta_kickout_even
 
 	rcu_read_lock();
 
+	spin_lock_bh(&dp->dp_lock);
+	dp_peer = ath12k_dp_link_peer_find_by_addr(dp, arg.mac_addr);
+	if (dp_peer) {
+		dp_sta = dp_peer->sta;
+		dp_vdev_id = dp_peer->vdev_id;
+		dp_peer_id = dp_peer->peer_id;
+		dp_link_id = dp_peer->link_id;
+		dp_mlo = dp_peer->mlo;
+		dp_peer_valid = true;
+	}
+	spin_unlock_bh(&dp->dp_lock);
+
 	spin_lock_bh(&ab->base_lock);
 
 	arsta = ath12k_link_sta_find_by_addr(ab, arg.mac_addr);
@@ -7646,6 +7665,42 @@ static void ath12k_peer_sta_kickout_even
 	ahsta = arsta->ahsta;
 	sta = ath12k_ahsta_to_sta(ahsta);
 
+	if (sta->mlo) {
+		if (arsta->link_id >= IEEE80211_MLD_MAX_NUM_LINKS ||
+		    !(sta->valid_links & BIT(arsta->link_id)) ||
+		    !(ahsta->links_map & BIT(arsta->link_id))) {
+			ath12k_warn(ab,
+				    "ignore stale peer sta kickout %pM for invalid MLO link %u (sta links 0x%x driver links 0x%x)\n",
+				    arg.mac_addr, arsta->link_id, sta->valid_links,
+				    ahsta->links_map);
+			goto exit;
+		}
+
+		link_sta = rcu_dereference(sta->link[arsta->link_id]);
+		if (!link_sta ||
+		    !ether_addr_equal(link_sta->addr, arg.mac_addr)) {
+			ath12k_warn(ab,
+				    "ignore stale peer sta kickout %pM for mismatched MLO link %u\n",
+				    arg.mac_addr, arsta->link_id);
+			goto exit;
+		}
+	} else if (!ether_addr_equal(sta->addr, arg.mac_addr)) {
+		ath12k_warn(ab, "ignore stale peer sta kickout %pM for STA %pM\n",
+			    arg.mac_addr, sta->addr);
+		goto exit;
+	}
+
+	if (dp_peer_valid &&
+	    (dp_sta != sta || dp_vdev_id != arvif->vdev_id ||
+	     dp_mlo != sta->mlo ||
+	     (sta->mlo && dp_link_id != arsta->link_id))) {
+		ath12k_warn(ab,
+			    "ignore stale peer sta kickout %pM for mismatched datapath peer %d vdev %d link %u mlo %d\n",
+			    arg.mac_addr, dp_peer_id, dp_vdev_id, dp_link_id,
+			    dp_mlo);
+		goto exit;
+	}
+
 	ath12k_dbg(ab, ATH12K_DBG_WMI,
 		   "peer sta kickout event %pM reason: %d rssi: %d\n",
 		   arg.mac_addr, arg.reason, arg.rssi);
