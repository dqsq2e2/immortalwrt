+/* Called with rx_lock held; never retain a datapath peer beyond dp_lock. */
+static int ath12k_ds_hw1_peer_vp(struct ath12k_ds *ds, struct ath12k_dp *owner,
+				 const struct rx_msdu_end_qcn9274 *msdu)
+{
+	struct ath12k_dp_link_peer *link;
+	struct ath12k_ds_peer *peer;
+	struct ath12k_ds_vp *vp;
+	u16 peer_id = le16_to_cpu(msdu->sa_sw_peer_id);
+	u8 source[ETH_ALEN] __aligned(2);
+	int vdev = -1, port = -1, i;
+
+	if (owner->peer_metadata_ver != ATH12K_PEER_METADATA_V1 ||
+	    peer_id != le32_get_bits(msdu->peer_meta_data,
+				    RX_MPDU_DESC_META_DATA_V1_PEER_ID))
+		return -ENOENT;
+	put_unaligned_be32(le32_to_cpu(msdu->sa_47_16), source);
+	put_unaligned_be16(le16_to_cpu(msdu->sa_15_0), source + 4);
+	if (!is_valid_ether_addr(source))
+		return -ENOENT;
+	spin_lock(&owner->dp_lock);
+	link = ath12k_dp_link_peer_find_by_addr(owner, source);
+	if (link && link->peer_id == peer_id && link->sta &&
+	    READ_ONCE(link->is_authorized) && !link->mlo)
+		vdev = link->vdev_id;
+	spin_unlock(&owner->dp_lock);
+	if (vdev < 0)
+		return -ENOENT;
+
+	spin_lock(&ds->peer_lock);
+	list_for_each_entry(peer, &ds->peers, list) {
+		if (peer->ar->ab != owner->ab || peer->vdev != vdev ||
+		    !READ_ONCE(peer->enabled) || !READ_ONCE(peer->authorized) ||
+		    !ether_addr_equal(peer->addr, source))
+			continue;
+		for (i = 0; i < ATH12K_DS_VP_COUNT; i++) {
+			vp = &ds->vps[i];
+			if (READ_ONCE(vp->vif) == peer->vif &&
+			    READ_ONCE(vp->direct) && !READ_ONCE(vp->closing)) {
+				port = READ_ONCE(vp->port);
+				break;
+			}
+		}
+		break;
+	}
+	spin_unlock(&ds->peer_lock);
+	return port >= 64 && port <= 255 ? port : -ENOENT;
+}
