+int ath12k_wifi7_ds_sta_state(struct ath12k *ar,
+			      struct ath12k_link_vif *arvif,
+			      struct ath12k_link_sta *arsta, bool enable)
+{
+	struct ath12k_ds_peer *peer, *tmp;
+	struct ath12k_ds *ds;
+	struct ath12k_dp *dp;
+	int i, error, ret = 0;
+
+	if (enable)
+		return ath12k_ds_peer_update(ar, arvif, arsta, true);
+	if (arvif->ahvif->vif->type != NL80211_IFTYPE_AP)
+		return 0;
+	ds = ath12k_ab_to_dp(ar->ab)->ds;
+	if (!ds)
+		return 0;
+	lockdep_assert_wiphy(ar->ah->hw->wiphy);
+	/* Primary/link maps may already have changed at teardown. */
+	for (i = 0; i < ATH12K_MAX_DEVICES; i++) {
+		dp = ar->ab->ag->dp_hw_grp.dp[i];
+		if (!dp || !dp->ds)
+			continue;
+		ds = dp->ds;
+		mutex_lock(&ds->control_lock);
+		list_for_each_entry_safe(peer, tmp, &ds->peers, list) {
+			if (peer->ar != ar || peer->vif != arvif->ahvif ||
+			    peer->vdev != arvif->vdev_id ||
+			    !ether_addr_equal(peer->addr, arsta->addr))
+				continue;
+			error = ath12k_ds_peer_cpu(ds, peer);
+			if (!ret)
+				ret = error;
+			spin_lock_bh(&ds->peer_lock);
+			list_del(&peer->list);
+			spin_unlock_bh(&ds->peer_lock);
+			dev_put(peer->dev);
+			kfree(peer);
+		}
+		if (!ds->stopped && !ds->faulted)
+			ath12k_ds_route_vif(ds, arvif->ahvif,
+					    ath12k_ds_vif_can_direct(ds, arvif->ahvif));
+		mutex_unlock(&ds->control_lock);
+	}
+	return ret;
+}
