 	int (*ds_sta_state)(struct ath12k *ar, struct ath12k_link_vif *arvif,
 			    struct ath12k_link_sta *arsta, bool enable);
 	void (*ds_vif_remove)(struct ath12k_link_vif *arvif, bool before, bool deleted);
