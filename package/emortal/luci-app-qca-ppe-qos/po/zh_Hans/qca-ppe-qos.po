msgid "To"
msgstr "目标"

#: luci-app-qca-ppe-qos/htdocs/luci-static/resources/view/network/qca-ppe-qos.js:124
msgid "Unmapped - bulk band"
msgstr "未映射 - 普通队列组"

#: luci-app-qca-ppe-qos/htdocs/luci-static/resources/view/network/qca-ppe-qos.js:188
#: luci-app-qca-ppe-qos/htdocs/luci-static/resources/view/network/qca-ppe-qos.js:189
