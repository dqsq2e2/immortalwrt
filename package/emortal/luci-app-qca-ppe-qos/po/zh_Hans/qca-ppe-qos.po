msgstr "未命名规则"

#: luci-app-qca-ppe-qos/htdocs/luci-static/resources/view/network/qca-ppe-qos.js:169
msgid "Uplink switch port"
msgstr "上联交换机端口"

#: luci-app-qca-ppe-qos/htdocs/luci-static/resources/view/network/qca-ppe-qos.js:29
