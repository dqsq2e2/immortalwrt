#!/usr/bin/ucode
'use strict';
import { cursor } from 'uci';
import { readfile, open, mkdir, stat, writefile, unlink } from 'fs';
import { connect } from 'ubus';
import { openlog, syslog, closelog, LOG_PID, LOG_DAEMON, LOG_DEBUG, LOG_INFO, LOG_NOTICE, LOG_WARNING, LOG_ERR } from 'log';
import { synchronize } from '/usr/share/router-role/auto.uc';
import { synchronize_wireless } from '/usr/share/router-role/wireless.uc';

// Keep interface events quiet unless the state or the failure changes.
function log_once(priority, key, message) {
	let path = '/var/run/router-role-log-' + key;
	if (readfile(path) == message) return;
	syslog(priority, '%s', message);
	writefile(path, message);
}

openlog('router-role', LOG_PID, LOG_DAEMON);
let stage = 'configuration lock';
let lock;
try {
	lock = open('/var/lock/router-role.lock', 'a');
	if (!lock || !lock.lock('x')) die('Cannot lock router role configuration');
	// LuCI uses session-specific deltas. Also avoid consuming unapplied CLI edits.
	for (let config in [ 'network', 'dhcp', 'firewall' ])
		if (stat('/tmp/.uci/' + config)?.size) {
			log_once(LOG_NOTICE, 'pending', 'Unapplied CLI changes found; automatic configuration is deferred');
			closelog();
			exit(0);
		}
	unlink('/var/run/router-role-log-pending');
	stage = 'configuration loading';
	mkdir('/var/run/router-role-delta', 0700);
	// Recompute an interrupted transaction from committed state. This
	// directory belongs exclusively to this helper, under the same lock.
	for (let config in [ 'network', 'dhcp', 'firewall', 'wireless' ])
		unlink('/var/run/router-role-delta/' + config);
	let uci = cursor('/etc/config', '/var/run/router-role-delta', '');
	let globals = null;
	uci.foreach('network', 'globals', section => { if (globals == null) globals = section['.name']; });
	let ap = uci.get('network', globals, 'router_role_ap') == '1';
	let missing_snapshot = ap && !uci.get('network', globals, 'router_role_ap_state');
	if (missing_snapshot) {
		let marker = '/var/run/router-role-ap-warning';
		// Interface events may be frequent; warn at most once per boot.
		if (!stat(marker)) {
			writefile(marker, '1\n');
			syslog(LOG_WARNING, '%s', 'AP mode flag is set without a saved LuCI snapshot; automatic AP conversion is skipped');
		}
	}
	let upstream = [];
	if (!ap) {
		try {
			let bus = connect();
			let status = bus?.call('network.interface.wan', 'status', {});
			upstream = map(status?.['ipv4-address'] || [], address => `${address.address}/${address.mask}`);
			bus?.disconnect();
			if (status) unlink('/var/run/router-role-log-wan');
			else log_once(LOG_DEBUG, 'wan', 'WAN status is unavailable; LAN subnet check awaits the next interface event');
		}
		catch (e) {
			log_once(LOG_WARNING, 'wan', 'WAN status query failed; LAN subnet check deferred: ' + e.message);
		}
	}
	stage = 'preset loading';
	let data = json(readfile('/usr/share/router-role/auto.json'));
	if (!data) die('Cannot read router role presets');
	stage = 'preset synchronization';
	let previous_lan = uci.get('network', 'lan', 'ipaddr');
	let changed = synchronize(uci, data, upstream);
	stage = 'wireless defaults';
	if (stat('/tmp/.uci/wireless')?.size) {
		log_once(LOG_NOTICE, 'wireless-pending', 'Unapplied CLI wireless changes found; wireless defaults are deferred');
	}
	else {
		unlink('/var/run/router-role-log-wireless-pending');
		let board = null;
		let text = readfile('/etc/board.json');
		try {
			if (text) board = json(text);
			unlink('/var/run/router-role-log-wireless-board');
		}
		catch (e) {
			log_once(LOG_WARNING, 'wireless-board', 'Wireless board capabilities are invalid; defaults deferred: ' + e.message);
		}
		if (board && synchronize_wireless(uci, board)) push(changed, 'wireless');
	}
	if (length(changed)) {
		log_once(LOG_INFO, 'update', 'Applying configuration updates: ' + join(' ', changed));
		let next_lan = uci.get('network', 'lan', 'ipaddr');
		if (sprintf('%J', previous_lan) != sprintf('%J', next_lan))
			log_once(LOG_NOTICE, 'lan', sprintf('LAN subnet overlaps WAN; changing %J to %J', previous_lan, next_lan));
	}
	for (let config in changed) {
		stage = 'commit ' + config;
		if (!uci.commit(config)) die(`Unable to commit router role settings in ${config}`);
		syslog(LOG_INFO, '%s', 'Committed configuration: ' + config);
	}
	let mode = ap ? 'ap' : uci.get('network', 'wan', 'proto') == 'pppoe' ? 'main' : 'sub';
	let status = sprintf('%J', { mode: missing_snapshot ? 'ap-pending' : mode,
		lan_proto: uci.get('network', 'lan', 'proto'), lan_address: uci.get('network', 'lan', 'ipaddr') });
	if (readfile('/var/run/router-role-status') != status) {
		if (!missing_snapshot)
			syslog(LOG_INFO, '%s', sprintf('Configuration mode: %s; LAN protocol: %s; LAN IPv4: %J',
				mode, uci.get('network', 'lan', 'proto'), uci.get('network', 'lan', 'ipaddr')));
		writefile('/var/run/router-role-status', status);
	}
	if (readfile('/var/run/router-role-log-error'))
		syslog(LOG_NOTICE, '%s', 'Automatic configuration recovered from the previous failure');
	unlink('/var/run/router-role-log-error');
	unlink('/var/run/router-role-log-update');
	unlink('/var/run/router-role-log-lan');
	// stdout is the init script's reload protocol, never a diagnostic stream.
	if (length(changed)) print(join(' ', changed), '\n');
}
catch (e) {
	let message = 'Failed during ' + stage + ': ' + e.message;
	log_once(LOG_ERR, 'error', message);
	warn('router-role: ' + message + '\n');
	closelog();
	exit(1);
}
closelog();
