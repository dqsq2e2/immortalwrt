#!/bin/sh /etc/rc.common

START=19
USE_PROCD=1

RELOAD_PLAN=/var/run/router-role-reload-pending

save_reload_plan() {
	local plan="$1" temporary="${RELOAD_PLAN}.$$"
	if [ -z "$plan" ]; then
		rm -f "$RELOAD_PLAN"
	else
		(umask 077; printf '%s\n' "$plan" > "$temporary") &&
			mv "$temporary" "$RELOAD_PLAN"
	fi
}

reload_step() {
	local name="$1" result
	shift
	"$@"
	result=$?
	if [ "$result" -ne 0 ]; then
		logger -t router-role -p daemon.err "$name reload failed (exit $result)"
		return "$result"
	fi
	logger -t router-role -p daemon.info "$name reload requested"
	return 0
}

start_service() {
	# Before netifd during boot, or reload when installing on a running router.
	if [ -n "$(ubus -S list network 2>/dev/null)" ]; then
		reload_service
	else
		/usr/libexec/router-role-auto >/dev/null
	fi
}

reload_service() {
	local changed plan remaining service need_network=0 need_firewall=0 need_dhcp=0
	changed="$(/usr/libexec/router-role-auto)" || return 1
	case " $changed " in
		*" network "*) need_network=1 need_dhcp=1 ;;
	esac
	case " $changed " in
		*" wireless "*) need_network=1 ;;
	esac
	case " $changed " in
		*" dhcp "*) need_dhcp=1 ;;
	esac
	case " $changed " in
		*" firewall "*) need_firewall=1 ;;
	esac
	plan="$(cat "$RELOAD_PLAN" 2>/dev/null)"
	[ "$need_network" -eq 0 ] || plan="$plan netifd"
	[ "$need_firewall" -eq 0 ] || plan="$plan firewall"
	[ "$need_dhcp" -eq 0 ] || {
		plan="$plan odhcpd"
		[ ! -x /etc/init.d/dnsmasq ] || plan="$plan dnsmasq"
	}
	remaining=
	for service in netifd firewall odhcpd dnsmasq; do
		case " $plan " in *" $service "*) remaining="${remaining:+$remaining }$service" ;; esac
	done
	[ -n "$remaining" ] || return 0
	save_reload_plan "$remaining" || return 1
	logger -t router-role -p daemon.info "Requesting service reloads: $remaining"
	for service in $remaining; do
		case "$service" in
			netifd) reload_step netifd ubus call network reload >/dev/null || return 1 ;;
			firewall) reload_step firewall /etc/init.d/firewall reload || return 1 ;;
			odhcpd) reload_step odhcpd /etc/init.d/odhcpd reload || return 1 ;;
			dnsmasq) reload_step dnsmasq /etc/init.d/dnsmasq reload || return 1 ;;
		esac
		remaining="${remaining#"$service"}"
		remaining="${remaining# }"
		save_reload_plan "$remaining" || return 1
	done
	return 0
}

service_triggers() {
	procd_add_reload_trigger network
	# Includes changes applied outside LuCI and a newly acquired WAN lease.
	procd_add_raw_trigger "interface.*" 1000 /etc/init.d/router-role reload
	procd_add_raw_trigger "router-role.wireless" 1000 /etc/init.d/router-role reload
}
