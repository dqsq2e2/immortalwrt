#!/bin/sh
# eth0/eth1 = switch A/B uplinks (LAN1-8), eth2/eth3 = SFP1/SFP2,
# eth4/eth5 = GE1/GE2 (88E1514, appear once velo5x0-switch has reset them).
# Port roles (520V 完美固件 defaults, per user):
#   LAN = both switches (8 jacks) + GE2(eth5)
#   WAN = GE1(eth4) primary, SFP1(eth2) / SFP2(eth3) secondary WANs
# LAN stays on 10.11.0.1/24 to avoid clashing with a 192.168.1.x upstream.
# Only seed the bridge on a fresh install; a preserved config (sysupgrade)
# already carries the user's port list (eth0/eth1 or the DSA lan1..lan8).
#
# Board guard: files/ is tree-global, so EVERY build from this source tree
# (including generic x86) gets this script. On non-VeloCloud hardware the
# port rewrite below would put nonexistent lan1..lan8 into br-lan and drop
# the box's only real NIC, making it unreachable. Run only on VeloCloud.
grep -qi velocloud /sys/class/dmi/id/sys_vendor 2>/dev/null || exit 0
if ! uci -q get network.@device[0].ports | grep -qE 'eth1|lan1'; then
	uci -q batch <<'UCI'
delete network.@device[0].ports
add_list network.@device[0].ports='lan1'
add_list network.@device[0].ports='lan2'
add_list network.@device[0].ports='lan3'
add_list network.@device[0].ports='lan4'
add_list network.@device[0].ports='lan5'
add_list network.@device[0].ports='lan6'
add_list network.@device[0].ports='lan7'
add_list network.@device[0].ports='lan8'
add_list network.@device[0].ports='eth5'
UCI
fi
uci -q batch <<'UCI'
set network.lan.ipaddr='10.11.0.1'
set network.lan.netmask='255.255.255.0'
set network.wan.device='eth4'
set network.wan6.device='eth4'
set network.wan_sfp1=interface
set network.wan_sfp1.proto='dhcp'
set network.wan_sfp1.device='eth2'
set network.wan_sfp1.metric='20'
set network.wan_sfp2=interface
set network.wan_sfp2.proto='dhcp'
set network.wan_sfp2.device='eth3'
set network.wan_sfp2.metric='30'
UCI
uci commit network
# put the SFP WANs in the wan firewall zone, and open SSH/LuCI on the wan
# side for bench management (close these if the box faces untrusted networks)
if ! uci -q get firewall.@zone[1].network | grep -q wan_sfp1; then
	uci -q batch <<'UCI'
add_list firewall.@zone[1].network='wan_sfp1'
add_list firewall.@zone[1].network='wan_sfp2'
set firewall.ssh_wan=rule
set firewall.ssh_wan.name='Allow-SSH-WAN'
set firewall.ssh_wan.src='wan'
set firewall.ssh_wan.dest_port='22'
set firewall.ssh_wan.proto='tcp'
set firewall.ssh_wan.target='ACCEPT'
set firewall.luci_wan=rule
set firewall.luci_wan.name='Allow-LuCI-WAN'
set firewall.luci_wan.src='wan'
set firewall.luci_wan.dest_port='80 443'
set firewall.luci_wan.proto='tcp'
set firewall.luci_wan.target='ACCEPT'
UCI
	uci commit firewall
fi
# front logo LED defaults (leds-pca963x via the glue): green steady = all good,
# red = the witness sees something down, blue = running on cellular
if ! uci -q get system.led_logo_green >/dev/null; then
	uci -q batch <<'UCI'
set system.led_logo_green=led
set system.led_logo_green.name='logo green'
set system.led_logo_green.sysfs='pca963x:green:logo'
set system.led_logo_green.trigger='default-on'
set system.led_logo_blue=led
set system.led_logo_blue.name='logo blue'
set system.led_logo_blue.sysfs='pca963x:blue:logo'
set system.led_logo_blue.trigger='none'
set system.led_logo_blue.default='0'
set system.led_logo_red=led
set system.led_logo_red.name='logo red'
set system.led_logo_red.sysfs='pca963x:red:logo'
set system.led_logo_red.trigger='none'
set system.led_logo_red.default='0'
UCI
	uci commit system
fi
exit 0
