#!/bin/sh
# Copyright (C) 2024 ViKing <viking.yfy@qq.com>

read -r usr sys < <(top -bn1 | awk '/^CPU:/ {print $2, $4; exit}')
read -r ipv4 ipv6 total < /sys/kernel/debug/3a000000.ppe/active_flows 2>/dev/null

# The driver counts installed bidirectional rules without formatting tuples.
read -r nss_ipv4 nss_ipv6 nss_total nss_limit \
	< /sys/bus/platform/devices/39000000.nss/flow_stats 2>/dev/null

echo -n "USR: ${usr:-N/A} SYS: ${sys:-N/A} PPE: ${total:-N/A} (IPv4: ${ipv4:-N/A} IPv6: ${ipv6:-N/A}) NSS: ${nss_total:-N/A}/${nss_limit:-N/A} (IPv4: ${nss_ipv4:-N/A} IPv6: ${nss_ipv6:-N/A})"
