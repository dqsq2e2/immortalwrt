#!/bin/sh /etc/rc.common
# shellcheck shell=ash
# shellcheck disable=SC2034,SC2154

START=93

PROC_ROOT=${PROC_ROOT:-/proc}
IRQ_ROOT=${IRQ_ROOT:-${PROC_ROOT}/irq}
IRQ_FILE=${IRQ_FILE:-${PROC_ROOT}/interrupts}
SYS_ROOT=${SYS_ROOT:-/sys}

log_status() {
	[ "$enable_log" = 1 ] || return 0
	logger -t smp_affinity "$*"
}

online_cpu() {
	local cpu="$1" range first last

	for range in $(printf '%s' "$online" | tr ',' ' '); do
		first="${range%-*}"
		last="${range#*-}"
		if [ "$cpu" -ge "$first" ] && [ "$cpu" -le "$last" ]; then
			printf '%s\n' "$cpu"
			return
		fi
	done
	# Keep the mapping valid if a CPU has been taken offline.
	printf '%s\n' "${online%%[-,]*}"
}

bind_irq() {
	local cpu="$2" path="$IRQ_ROOT/$1" current

	[ -r "$path/smp_affinity_list" ] || return 1
	read -r current < "$path/smp_affinity_list"
	if [ "$current" != "$cpu" ]; then
		echo "$cpu" > "$path/smp_affinity_list" || return 1
		changed=$((changed + 1))
	fi
	read -r current < "$path/smp_affinity_list"
	[ "$current" = "$cpu" ] || return 1
	if [ -r "$path/effective_affinity_list" ]; then
		read -r current < "$path/effective_affinity_list"
		# The kernel can defer migration until this IRQ fires again. A
		# matching requested mask is success; report pending effective moves.
		[ "$current" = "$cpu" ] || pending=$((pending + 1))
	fi
	return 0
}

start() {
	local enable enable_log online irq cpu name changed=0 failed=0 pending=0

	config_load smp_affinity
	config_get_bool enable general enable 1
	config_get_bool enable_log general enable_log 1
	[ "$enable" = 1 ] || return 0
	online="$(cat "$SYS_ROOT/devices/system/cpu/online")" || return 1
	[ -n "$online" ] || return 1

	# EDMA queue i and its three IRQs share CPU i, matching the driver.
	# Bind registered wireless IRQs without waiting for inactive radios.
	while read -r irq cpu name; do
		[ -n "$irq" ] || continue
		cpu="$(online_cpu "$cpu")"
		if ! bind_irq "$irq" "$cpu"; then
			log_status "IRQ $irq ($name): affinity to CPU$cpu failed readback"
			failed=$((failed + 1))
		fi
	done <<EOF
$(awk '
	$1 ~ /^[0-9]+:$/ {
		name = $NF; sub(/:$/, "", name); cpu = -1
		if (name ~ /^edma_(rxdesc|rxfill|txcmpl)[0-3]$/) cpu = substr(name, length(name))
		else if (name ~ /^reo2host-destination-ring[1-4]$/) cpu = substr(name, length(name)) - 1
		else if (name ~ /^wbm2host-tx-completions-ring[1-3]$/ || name ~ /^ppdu-end-interrupts-mac[1-3]$/) cpu = substr(name, length(name))
		if (cpu >= 0) {sub(/:$/, "", $1); print $1, cpu, name}
	}' "$IRQ_FILE")
EOF
	if [ "$changed" -gt 0 ] || [ "$failed" -gt 0 ]; then
		log_status "IRQ affinity: changed=$changed failed=$failed pending=$pending"
	fi
	[ "$failed" -eq 0 ]
}
