From: ViKing <viking.yfy@qq.com>
Date: Sat, 31 Oct 2026 00:57:36 +0800
Subject: [PATCH] arm64: dts: qcom: ipq6018: describe CMN PLL and GCC inputs

Pass both CMN PLL bias outputs to GCC by phandle and name. Keep the
provider in the SoC DTSI, alongside the existing UNIPHY input references,
so the ESS include no longer duplicates the GCC clocks and clock-names.

Place the 48 MHz reference under /clocks and the CMN PLL at its SoC MMIO
address, following the IPQ8074 CMN PLL layout. Preserve the IPQ6018
416.5 MHz NSS NoC bias clock, 12 GHz PLL assignment and GCC input names.

Retain this patch's upstream filename and application position so future
upstream changes can be merged in place. The original GCC input change
was authored by Robert Marko; this revision also owns the previously
out-of-tree provider description.

Based-on: 0d245fdaeae5c890c8aa997fadcf9287a707558f
Fixes: 5df1a6ab80ab ("qualcommax: ipq60xx: pass UNIPHY clocks directly to GCC")
Signed-off-by: Robert Marko <robimarko@gmail.com>
Signed-off-by: ViKing <viking.yfy@qq.com>
---
--- a/arch/arm64/boot/dts/qcom/ipq6018.dtsi
+++ b/arch/arm64/boot/dts/qcom/ipq6018.dtsi
@@ -11,6 +11,7 @@
 #include <dt-bindings/clock/qcom,apss-ipq.h>
 #include <dt-bindings/thermal/thermal.h>
 #include <dt-bindings/net/qca-uniphy.h>
+#include <dt-bindings/clock/qcom,ipq6018-cmn-pll.h>
 
 / {
 	#address-cells = <2>;
@@ -18,6 +19,12 @@
 	interrupt-parent = <&intc>;
 
 	clocks {
+		ref_48mhz_clk: ref-48mhz-clk {
+			compatible = "fixed-clock";
+			clock-frequency = <48000000>;
+			#clock-cells = <0>;
+		};
+
 		sleep_clk: sleep-clk {
 			compatible = "fixed-clock";
 			clock-frequency = <32000>;
@@ -338,6 +345,18 @@
 			status = "disabled";
 		};
 
+		cmn_pll: clock-controller@9b000 {
+			compatible = "qcom,ipq6018-cmn-pll";
+			reg = <0x0 0x0009b000 0x0 0x800>;
+			clocks = <&ref_48mhz_clk>,
+				 <&gcc GCC_CMN_12GPLL_AHB_CLK>,
+				 <&gcc GCC_CMN_12GPLL_SYS_CLK>;
+			clock-names = "ref", "ahb", "sys";
+			#clock-cells = <1>;
+			assigned-clocks = <&cmn_pll IPQ6018_CMN_PLL_CLK>;
+			assigned-clock-rates-u64 = /bits/ 64 <12000000000>;
+		};
+
 		qfprom: efuse@a4000 {
 			compatible = "qcom,ipq6018-qfprom", "qcom,qfprom";
 			reg = <0x0 0x000a4000 0x0 0x2000>;
@@ -426,13 +445,17 @@
 				 <&uniphy0 UNIPHY_CLK_RX>,
 				 <&uniphy0 UNIPHY_CLK_TX>,
 				 <&uniphy1 UNIPHY_CLK_RX>,
-				 <&uniphy1 UNIPHY_CLK_TX>;
+				 <&uniphy1 UNIPHY_CLK_TX>,
+				 <&cmn_pll IPQ6018_BIAS_PLL_CC_CLK>,
+				 <&cmn_pll IPQ6018_BIAS_PLL_NSS_NOC_CLK>;
 			clock-names = "xo",
 				      "sleep_clk",
 				      "uniphy0_gcc_rx_clk",
 				      "uniphy0_gcc_tx_clk",
 				      "uniphy1_gcc_rx_clk",
-				      "uniphy1_gcc_tx_clk";
+				      "uniphy1_gcc_tx_clk",
+				      "bias_pll_cc_clk",
+				      "bias_pll_nss_noc_clk";
 			#clock-cells = <1>;
 			#reset-cells = <1>;
 		};
