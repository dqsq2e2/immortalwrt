From: ViKing <viking.yfy@qq.com>
Date: Tue, 13 Oct 2026 23:50:41 +0800
Subject: [PATCH] debug: qca-edma expose Wi-Fi PPE matrix snapshot

Expose a read-only debugfs snapshot for 807x Wi-Fi/PPE matrix runs. The
snapshot joins EDMA ring progress, link state, driver error counters and
software checksum fallback events without changing the packet path.

Signed-off-by: ViKing <viking.yfy@qq.com>
---
--- a/drivers/net/ethernet/qualcomm/qca_edma.c
+++ b/drivers/net/ethernet/qualcomm/qca_edma.c
@@ -6,6 +6,7 @@
 
 #include <linux/bitfield.h>
 #include <linux/clk.h>
+#include <linux/debugfs.h>
 #include <linux/ethtool.h>
 #include <linux/hash.h>
 #include <linux/if_vlan.h>
@@ -21,6 +22,7 @@
 #include <linux/property.h>
 #include <linux/regmap.h>
 #include <linux/reset.h>
+#include <linux/seq_file.h>
 #include <linux/tcp.h>
 #include <linux/udp.h>
 #include <net/ip.h>
@@ -2110,6 +2112,78 @@ static int edma_get_mac_address(struct n
 	return -ENODEV;
 }
 
+/*
+ * One read joins the EDMA ring cursors with driver error counters. The
+ * matrix runner uses it before and after bounded transfers; it never writes
+ * hardware and never emits a packet-path log.
+ */
+static int edma_matrix_snapshot_show(struct seq_file *s, void *data)
+{
+	struct edma_priv *priv = s->private;
+	const struct edma_soc_data *soc = priv->soc;
+	u32 txp, txc, txcp, txcc, rxfp, rxfp_cons, rxdp, rxdc;
+	int ret = 0;
+
+	ret |= regmap_read(priv->regmap,
+			   EDMA_REG_TXDESC_PROD_IDX(soc->txdesc_ring), &txp);
+	ret |= regmap_read(priv->regmap,
+			   EDMA_REG_TXDESC_CONS_IDX(soc->txdesc_ring), &txc);
+	ret |= regmap_read(priv->regmap,
+			   EDMA_REG_TXCMPL_PROD_IDX(soc->txcmpl_base,
+						    soc->txcmpl_ring), &txcp);
+	ret |= regmap_read(priv->regmap,
+			   EDMA_REG_TXCMPL_CONS_IDX(soc->txcmpl_base,
+						    soc->txcmpl_ring), &txcc);
+	ret |= regmap_read(priv->regmap,
+			   EDMA_REG_RXFILL_PROD_IDX(soc->rxfill_ring), &rxfp);
+	ret |= regmap_read(priv->regmap,
+			   EDMA_REG_RXFILL_CONS_IDX(soc->rxfill_ring), &rxfp_cons);
+	ret |= regmap_read(priv->regmap,
+			   EDMA_REG_RXDESC_PROD_IDX(soc->rxdesc_ring), &rxdp);
+	ret |= regmap_read(priv->regmap,
+			   EDMA_REG_RXDESC_CONS_IDX(soc->rxdesc_ring), &rxdc);
+	if (ret)
+		return -EIO;
+
+	seq_printf(s,
+		   "revision:r2 running:%u carrier:%u mtu:%u "
+		   "tx_prod:%u tx_cons:%u txcmpl_prod:%u txcmpl_cons:%u "
+		   "rxfill_prod:%u rxfill_cons:%u rxdesc_prod:%u rxdesc_cons:%u "
+		   "tx_pending_reopen:%llu rx_pending_reopen:%llu "
+		   "rx_untracked_page:%llu rx_bad_src_info:%llu rx_no_skb:%llu "
+		   "rx_no_tag:%llu rx_split_frame:%llu rx_fill_starved:%llu "
+		   "tx_desc_error:%llu tx_unnamed_frame:%llu misc_error:%llu "
+		   "rx_ppe_csum_drop:%llu rx_ppe_csum_fallback:%llu\n",
+		   netif_running(priv->netdev), netif_carrier_ok(priv->netdev),
+		   priv->netdev->mtu, txp, txc, txcp, txcc, rxfp, rxfp_cons,
+		   rxdp, rxdc, priv->stats.tx_pending_reopen,
+		   priv->stats.rx_pending_reopen, priv->stats.rx_untracked_page,
+		   priv->stats.rx_bad_src_info, priv->stats.rx_no_skb,
+		   priv->stats.rx_no_tag, priv->stats.rx_split_frame,
+		   priv->stats.rx_fill_starved, priv->stats.tx_desc_error,
+		   priv->stats.tx_unnamed_frame, priv->stats.misc_error,
+		   priv->stats.rx_ppe_csum_drop,
+		   priv->stats.rx_ppe_csum_fallback);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(edma_matrix_snapshot);
+
+static void edma_matrix_debugfs_init(struct edma_priv *priv)
+{
+	priv->matrix_debugfs = debugfs_create_dir(dev_name(&priv->pdev->dev),
+						  NULL);
+	if (IS_ERR_OR_NULL(priv->matrix_debugfs))
+		return;
+	debugfs_create_file("matrix_snapshot", 0400, priv->matrix_debugfs, priv,
+			    &edma_matrix_snapshot_fops);
+}
+
+static void edma_matrix_debugfs_exit(struct edma_priv *priv)
+{
+	debugfs_remove_recursive(priv->matrix_debugfs);
+	priv->matrix_debugfs = NULL;
+}
+
 static int edma_probe(struct platform_device *pdev)
 {
 	struct clk_bulk_data *clks;
@@ -2224,6 +2298,7 @@ static int edma_probe(struct platform_de
 		goto err_irq;
 	}
 
+	edma_matrix_debugfs_init(priv);
 	ret = dev_set_threaded(netdev, NETDEV_NAPI_THREADED_ENABLED);
 	if (ret)
 		dev_warn(dev, "failed to enable threaded NAPI: %d\n", ret);
@@ -2247,6 +2322,7 @@ static void edma_remove(struct platform_
 	struct edma_priv *priv = platform_get_drvdata(pdev);
 
 	qca_ppe_wifi_inject_unregister(&priv->wifi_inject_ops);
+	edma_matrix_debugfs_exit(priv);
 	unregister_netdev(priv->netdev);
 	netif_napi_del(&priv->tx_napi);
 	netif_napi_del(&priv->rx_napi);
--- a/drivers/net/ethernet/qualcomm/qca_edma.h
+++ b/drivers/net/ethernet/qualcomm/qca_edma.h
@@ -333,8 +333,11 @@ struct edma_ring {
 	struct page **page_store;
 };
 
+struct dentry;
+
 struct edma_priv {
 	struct qca_ppe_wifi_inject_ops wifi_inject_ops;
+	struct dentry *matrix_debugfs;
 	const struct edma_soc_data *soc;
 	struct napi_struct tx_napi;
 	struct napi_struct rx_napi;
