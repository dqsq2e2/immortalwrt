/dts-v1/;

#include "ipq9574-be7000-common.dtsi"

/ {
	model = "Xiaomi BE7000 Pro";
	compatible = "xiaomi,be7000-pro", "qcom,ipq9574";

	reserved-memory {
		qcn9274_pcie2_region: wifi@58500000 {
			reg = <0x0 0x58500000 0x0 0x3a00000>;
			no-map;
		};
	};
};

&wifi6 {
	qcom,calibration-variant = "Xiaomi-BE7000-Pro";
};

&wifi0 {
	qcom,calibration-variant = "Xiaomi-BE7000-Pro";
};
