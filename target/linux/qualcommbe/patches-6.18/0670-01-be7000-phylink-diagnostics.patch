From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OpenWrt
Subject: [PATCH] qualcommbe: diagnose BE7000 phylink failure

Report the device tree node and error when BE7000 phylink fails to
attach a PHY so probe failures can be located without repeated polling.

[viking.yfy@qq.com: complete imported patch metadata]
Signed-off-by: VIKINGYFY <viking.yfy@qq.com>
---
--- a/drivers/net/phy/phylink.c
+++ b/drivers/net/phy/phylink.c
@@ -2447,6 +2447,12 @@ static int phylink_bringup_phy(struct ph
 			     __ETHTOOL_LINK_MODE_MASK_NBITS, phy->supported,
 			     __ETHTOOL_LINK_MODE_MASK_NBITS, config.advertising,
 			     ERR_PTR(ret));
+		dev_err(pl->config->dev,
+			"BE7000 debug: validation phy=%s iface=%s ret=%pe supported=%*pb advertisement=%*pb possible=%*pbl\n",
+			dev_name(&phy->mdio.dev), phy_modes(config.interface), ERR_PTR(ret),
+			__ETHTOOL_LINK_MODE_MASK_NBITS, phy->supported,
+			__ETHTOOL_LINK_MODE_MASK_NBITS, config.advertising,
+			(int)PHY_INTERFACE_MODE_MAX, phy->possible_interfaces);
 		return ret;
 	}
 
@@ -2690,13 +2696,23 @@ int phylink_fwnode_phy_connect(struct ph
 
 	ret = phy_attach_direct(pl->netdev, phy_dev, flags,
 				pl->link_interface);
+	if (ret)
+		dev_err(pl->config->dev,
+			"BE7000 debug: phy_attach_direct phy=%s iface=%s ret=%pe\n",
+			dev_name(&phy_dev->mdio.dev), phy_modes(pl->link_interface),
+			ERR_PTR(ret));
 	phy_device_free(phy_dev);
 	if (ret)
 		return ret;
 
 	ret = phylink_bringup_phy(pl, phy_dev, pl->link_config.interface);
-	if (ret)
+	if (ret) {
+		dev_err(pl->config->dev,
+			"BE7000 debug: phylink_bringup_phy phy=%s iface=%s ret=%pe\n",
+			dev_name(&phy_dev->mdio.dev), phy_modes(pl->link_config.interface),
+			ERR_PTR(ret));
 		phy_detach(phy_dev);
+	}
 
 	return ret;
 }
--- a/drivers/net/phy/phy_device.c
+++ b/drivers/net/phy/phy_device.c
@@ -1975,8 +1975,11 @@ int phy_attach_direct(struct net_device
 	 * (dev_flags and interface)
 	 */
 	err = phy_init_hw(phydev);
-	if (err)
+	if (err) {
+		phydev_err(phydev, "BE7000 debug: phy_init_hw iface=%s ret=%pe\n",
+			   phy_modes(phydev->interface), ERR_PTR(err));
 		goto error;
+	}
 
 	if (phydev->mdio.bus->notify_phy_attach) {
 		err = phydev->mdio.bus->notify_phy_attach(phydev);
