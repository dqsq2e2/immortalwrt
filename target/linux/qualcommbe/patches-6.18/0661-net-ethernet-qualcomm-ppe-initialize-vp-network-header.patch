From: ViKing <viking.yfy@qq.com>
Subject: [PATCH] net: ethernet: qualcomm: ppe: initialize VP network headers

EDMA submits hardware-forwarded VP frames directly to dev_queue_xmit(),
bypassing the receive core that normally initializes the network header.
The fresh RX skb retains network_header zero, pointing into uninitialized
headroom. Wireless DSCP classification and flow dissection consequently
read the wrong bytes. Packet taps also report "protocol 0800 is buggy".

Set the network header from the descriptor L3 offset, matching the QSDK
VP receive path. Reject offsets outside the frame and pull the base IPv6
header (or the whole shorter frame) into the linear area so the wireless
classifier can safely access both IPv4 and IPv6 headers in page mode.

Signed-off-by: ViKing <viking.yfy@qq.com>
---
--- a/drivers/net/ethernet/qualcomm/ppe/edma_rx.c
+++ b/drivers/net/ethernet/qualcomm/ppe/edma_rx.c
@@ -9,6 +9,7 @@
 #include <linux/dma-mapping.h>
 #include <linux/etherdevice.h>
 #include <linux/irqreturn.h>
+#include <linux/ipv6.h>
 #include <linux/kernel.h>
 #include <linux/netdevice.h>
 #include <linux/platform_device.h>
@@ -28,6 +29,7 @@
 static bool edma_rx_deliver_vp(struct edma_rxdesc_pri *rxdesc_pri,
 			       struct sk_buff *skb);
 
+
 static struct sk_buff *edma_rx_alloc_skb(unsigned int len)
 {
 	struct sk_buff *skb;
@@ -461,6 +463,7 @@ static bool edma_rx_deliver_vp(struct ed
 {
 	struct ppe_device *ppe_dev = edma_ctx->ppe_dev;
 	struct net_device *dev;
+	u32 l3_offset, pull_len;
 	int vp;
 
 	if (!edma_ctx->has_vports)
@@ -478,9 +481,27 @@ static bool edma_rx_deliver_vp(struct ed
 		return true;
 	}
 
+	l3_offset = EDMA_RXDESC_L3_OFFSET_GET(rxdesc_pri);
+	if (unlikely(l3_offset < ETH_HLEN || l3_offset >= skb->len)) {
+		rcu_read_unlock();
+		dev_kfree_skb_any(skb);
+		return true;
+	}
+	/* The receive core normally initializes this header, but hardware
+	 * forwarded VP frames bypass it. Wireless DSCP classification reads
+	 * directly from the network header, including for page-mode skbs.
+	 */
+	pull_len = min_t(unsigned int, skb->len,
+			 l3_offset + sizeof(struct ipv6hdr));
+	if (unlikely(!pskb_may_pull(skb, pull_len))) {
+		rcu_read_unlock();
+		dev_kfree_skb_any(skb);
+		return true;
+	}
 	skb->dev = dev;
 	skb_reset_mac_header(skb);
 	skb->protocol = eth_hdr(skb)->h_proto;
+	skb_set_network_header(skb, l3_offset);
 	dev_queue_xmit(skb);
 	rcu_read_unlock();
 
