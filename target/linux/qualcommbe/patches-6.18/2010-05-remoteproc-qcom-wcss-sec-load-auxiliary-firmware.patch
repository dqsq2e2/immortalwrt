From: George Moussalem <george.moussalem@outlook.com>
Subject: [PATCH] remoteproc: qcom: wcss-sec: load auxiliary firmware

Allow up to three firmware names for secure WCSS and load the auxiliary
MDT images after authenticating the Q6 image. IPQ9574 needs a separate M3
image. Keep the existing UserPD bootargs preparation and single-image
IPQ5332 behaviour. Fail if an explicitly listed auxiliary file is absent.

Link: https://github.com/openwrt/openwrt/pull/25595
Signed-off-by: George Moussalem <george.moussalem@outlook.com>
---
--- a/drivers/remoteproc/qcom_q6v5_wcss_sec.c
+++ b/drivers/remoteproc/qcom_q6v5_wcss_sec.c
@@ -31,6 +31,7 @@
 #define MPD_WCSS_PAS_ID			0xd
 
 #define Q6_WAIT_TIMEOUT			(5 * HZ)
+#define WCSS_MAX_FIRMWARE		3
 
 struct wcss_sec {
 	struct device *dev;
@@ -42,6 +43,7 @@ struct wcss_sec {
 	void *mem_region;
 	size_t mem_size;
 	const struct wcss_data *desc;
+	const char *firmware[WCSS_MAX_FIRMWARE];
 };
 
 struct wcss_data {
@@ -244,7 +246,8 @@ static int wcss_sec_load(struct rproc *r
 {
 	struct wcss_sec *wcss = rproc->priv;
 	struct device *dev = wcss->dev;
-	int ret;
+	const struct firmware *aux_fw;
+	int i, ret;
 
 	ret = wcss_sec_prepare_userpd_bootargs(rproc);
 	if (ret) {
@@ -257,6 +260,24 @@ static int wcss_sec_load(struct rproc *r
 	if (ret)
 		return ret;
 
+	for (i = 1; i < ARRAY_SIZE(wcss->firmware); i++) {
+		if (!wcss->firmware[i])
+			break;
+
+		ret = request_firmware(&aux_fw, wcss->firmware[i], dev);
+		if (ret)
+			return dev_err_probe(dev, ret, "failed to request firmware %s\n",
+					     wcss->firmware[i]);
+
+		ret = qcom_mdt_load_no_init(dev, aux_fw, wcss->firmware[i],
+					    wcss->mem_region, wcss->mem_phys,
+					    wcss->mem_size, &wcss->mem_reloc);
+		release_firmware(aux_fw);
+		if (ret)
+			return dev_err_probe(dev, ret, "failed to load firmware %s\n",
+					     wcss->firmware[i]);
+	}
+
 	qcom_pil_info_store("wcss", wcss->mem_phys, wcss->mem_size);
 
 	return 0;
@@ -373,20 +394,26 @@ static int wcss_sec_alloc_memory_region(
 static int wcss_sec_probe(struct platform_device *pdev)
 {
 	const struct wcss_data *desc = of_device_get_match_data(&pdev->dev);
-	const char *fw_name = NULL;
+	const char *firmware[WCSS_MAX_FIRMWARE] = {};
 	struct wcss_sec *wcss;
 	struct clk *sleep_clk;
 	struct clk *int_clk;
 	struct rproc *rproc;
 	int ret;
 
-	ret = of_property_read_string(pdev->dev.of_node, "firmware-name",
-				      &fw_name);
+	ret = of_property_count_strings(pdev->dev.of_node, "firmware-name");
+	if (ret < 0)
+		return ret;
+	if (!ret || ret > ARRAY_SIZE(firmware))
+		return -EINVAL;
+
+	ret = of_property_read_string_array(pdev->dev.of_node, "firmware-name",
+					    firmware, ret);
 	if (ret < 0)
 		return ret;
 
 	rproc = devm_rproc_alloc(&pdev->dev, desc->ss_name, &wcss_sec_ops,
-				 fw_name, sizeof(*wcss));
+				 firmware[0], sizeof(*wcss));
 	if (!rproc) {
 		dev_err(&pdev->dev, "failed to allocate rproc\n");
 		return -ENOMEM;
@@ -395,6 +422,7 @@ static int wcss_sec_probe(struct platfor
 	wcss = rproc->priv;
 	wcss->dev = &pdev->dev;
 	wcss->desc = desc;
+	memcpy(wcss->firmware, firmware, sizeof(firmware));
 
 	ret = wcss_sec_alloc_memory_region(wcss);
 	if (ret)
