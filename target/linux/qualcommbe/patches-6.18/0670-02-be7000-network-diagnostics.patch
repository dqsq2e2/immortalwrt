From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OpenWrt
Subject: [PATCH] qualcommbe: add BE7000 network diagnostics

Add bounded initialization diagnostics for the BE7000 MAC, QCA8084 PHY
and SerDes paths to identify clock, reset and link setup failures.

[viking.yfy@qq.com: complete imported patch metadata]
Signed-off-by: VIKINGYFY <viking.yfy@qq.com>
---
--- a/drivers/net/ethernet/qualcomm/ppe/ppe_port.c
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_port.c
@@ -1190,16 +1190,27 @@ int ppe_port_phylink_setup(struct ppe_po
 
 	/* Get PCS instance */
 	pcs_node = of_parse_phandle(ppe_port->np, "pcs-handle", 0);
-	if (!pcs_node)
+	if (!pcs_node) {
+		dev_err(ppe_dev->dev,
+			"BE7000 debug: PPE port %d missing pcs-handle\n",
+			ppe_port->port_id);
 		return -ENODEV;
+	}
 
 	ppe_port->pcs = ipq_pcs_get(pcs_node);
-	of_node_put(pcs_node);
 	if (IS_ERR(ppe_port->pcs)) {
-		dev_err(ppe_dev->dev, "PPE port %d failed to create PCS\n",
-			ppe_port->port_id);
+		dev_err(ppe_dev->dev,
+			"BE7000 debug: PPE port %d failed to create PCS node=%pOF ret=%pe\n",
+			ppe_port->port_id, pcs_node, ERR_PTR(PTR_ERR(ppe_port->pcs)));
+		of_node_put(pcs_node);
 		return PTR_ERR(ppe_port->pcs);
 	}
+	of_node_put(pcs_node);
+
+	dev_info(ppe_dev->dev,
+		"BE7000 debug: PPE port %d setup np=%pOF phy_mode=%s netdev=%s pcs=%p\n",
+		ppe_port->port_id, ppe_port->np, phy_modes(ppe_port->interface),
+		netdev->name, ppe_port->pcs);
 
 	/* Port phylink capability */
 	ppe_port->phylink_config.dev = &netdev->dev;
@@ -1218,8 +1229,10 @@ int ppe_port_phylink_setup(struct ppe_po
 					   ppe_port->interface,
 					   &ppe_phylink_ops);
 	if (IS_ERR(ppe_port->phylink)) {
-		dev_err(ppe_dev->dev, "PPE port %d failed to create phylink\n",
-			ppe_port->port_id);
+		dev_err(ppe_dev->dev,
+			"BE7000 debug: PPE port %d failed to create phylink ret=%pe phy_mode=%s\n",
+			ppe_port->port_id, ERR_PTR(PTR_ERR(ppe_port->phylink)),
+			phy_modes(ppe_port->interface));
 		ret = PTR_ERR(ppe_port->phylink);
 		goto err_free_pcs;
 	}
@@ -1227,8 +1240,9 @@ int ppe_port_phylink_setup(struct ppe_po
 	/* Connect phylink */
 	ret = phylink_of_phy_connect(ppe_port->phylink, ppe_port->np, 0);
 	if (ret) {
-		dev_err(ppe_dev->dev, "PPE port %d failed to connect phylink: %pe\n",
-			ppe_port->port_id, ERR_PTR(ret));
+		dev_err(ppe_dev->dev,
+			"BE7000 debug: PPE port %d failed to connect phylink: %pe phy_mode=%s\n",
+			ppe_port->port_id, ERR_PTR(ret), phy_modes(ppe_port->interface));
 		goto err_free_phylink;
 	}
 
--- a/drivers/net/phy/phylink.c
+++ b/drivers/net/phy/phylink.c
@@ -2448,11 +2448,13 @@ static int phylink_bringup_phy(struct ph
 			     __ETHTOOL_LINK_MODE_MASK_NBITS, config.advertising,
 			     ERR_PTR(ret));
 		dev_err(pl->config->dev,
-			"BE7000 debug: validation phy=%s iface=%s ret=%pe supported=%*pb advertisement=%*pb possible=%*pbl\n",
+			"BE7000 debug: validation phy=%s iface=%s ret=%pe supported=%*pb advertisement=%*pb possible=%*pbl mac_ifaces=%*pbl an=%d link_iface=%s\n",
 			dev_name(&phy->mdio.dev), phy_modes(config.interface), ERR_PTR(ret),
 			__ETHTOOL_LINK_MODE_MASK_NBITS, phy->supported,
 			__ETHTOOL_LINK_MODE_MASK_NBITS, config.advertising,
-			(int)PHY_INTERFACE_MODE_MAX, phy->possible_interfaces);
+			(int)PHY_INTERFACE_MODE_MAX, phy->possible_interfaces,
+			(int)PHY_INTERFACE_MODE_MAX, pl->config->supported_interfaces,
+			pl->cfg_link_an_mode, phy_modes(pl->link_config.interface));
 		return ret;
 	}
 
@@ -2655,16 +2657,25 @@ int phylink_fwnode_phy_connect(struct ph
 
 	phy_fwnode = fwnode_get_phy_node(fwnode);
 	if (IS_ERR(phy_fwnode)) {
-		if (pl->cfg_link_an_mode == MLO_AN_PHY)
+		if (pl->cfg_link_an_mode == MLO_AN_PHY) {
+			dev_err(pl->config->dev,
+				"BE7000 debug: fwnode_get_phy_node failed ret=%pe an=%d link_iface=%s\n",
+				ERR_PTR(PTR_ERR(phy_fwnode)), pl->cfg_link_an_mode,
+				phy_modes(pl->link_interface));
 			return -ENODEV;
+		}
 		return 0;
 	}
 
 	phy_dev = fwnode_phy_find_device(phy_fwnode);
 	/* We're done with the phy_node handle */
 	fwnode_handle_put(phy_fwnode);
-	if (!phy_dev)
+	if (!phy_dev) {
+		dev_err(pl->config->dev,
+			"BE7000 debug: fwnode_phy_find_device returned NULL an=%d link_iface=%s\n",
+			pl->cfg_link_an_mode, phy_modes(pl->link_interface));
 		return -ENODEV;
+	}
 
 	/* Use PHY device/driver interface */
 	if (pl->link_interface == PHY_INTERFACE_MODE_NA) {
@@ -2698,9 +2709,11 @@ int phylink_fwnode_phy_connect(struct ph
 				pl->link_interface);
 	if (ret)
 		dev_err(pl->config->dev,
-			"BE7000 debug: phy_attach_direct phy=%s iface=%s ret=%pe\n",
-			dev_name(&phy_dev->mdio.dev), phy_modes(pl->link_interface),
-			ERR_PTR(ret));
+			"BE7000 debug: phy_attach_direct phy=%s phy_iface=%s iface=%s ret=%pe host_ifaces=%*pbl possible=%*pbl\n",
+			dev_name(&phy_dev->mdio.dev), phy_modes(phy_dev->interface),
+			phy_modes(pl->link_interface), ERR_PTR(ret),
+			(int)PHY_INTERFACE_MODE_MAX, phy_dev->host_interfaces,
+			(int)PHY_INTERFACE_MODE_MAX, phy_dev->possible_interfaces);
 	phy_device_free(phy_dev);
 	if (ret)
 		return ret;
--- a/drivers/net/phy/qcom/qca8084_serdes.c
+++ b/drivers/net/phy/qcom/qca8084_serdes.c
@@ -257,6 +257,7 @@ struct mdio_device *qca8084_package_pcs_
 	}
 
 	mdiodev_set_drvdata(mdiodev, pcs_data);
+	dev_info(dev, "BE7000 debug: QCA8084 PCS resources ready\n");
 
 	return mdiodev;
 }
@@ -293,8 +294,12 @@ struct mdio_device *qca8084_package_xpcs
 
 	/* Sanity check the number of channel sub nodes */
 	node = of_get_available_child_count(xpcs_np);
-	if (node != QCA8084_CHANNEL_MAX)
+	if (node != QCA8084_CHANNEL_MAX) {
+		dev_err(dev,
+			"BE7000 debug: QCA8084 XPCS channel count=%d expected=%d\n",
+			node, QCA8084_CHANNEL_MAX);
 		return ERR_PTR(-EINVAL);
+	}
 
 	node = 0;
 	for_each_available_child_of_node(xpcs_np, child) {
@@ -348,6 +353,14 @@ struct mdio_device *qca8084_package_xpcs
 	}
 
 	mdiodev_set_drvdata(mdiodev, xpcs_data);
+	if (node == QCA8084_CHANNEL_MAX)
+		dev_info(dev,
+			"BE7000 debug: QCA8084 XPCS channels ready ids=%d,%d,%d,%d\n",
+			xpcs_data->xpcs_ch[0].ch_id, xpcs_data->xpcs_ch[1].ch_id,
+			xpcs_data->xpcs_ch[2].ch_id, xpcs_data->xpcs_ch[3].ch_id);
+	else
+		dev_err(dev,
+			"BE7000 debug: QCA8084 XPCS parsed only %d channels\n", node);
 
 	return mdiodev;
 
--- a/drivers/net/phy/qcom/qca808x.c
+++ b/drivers/net/phy/qcom/qca808x.c
@@ -1309,16 +1309,26 @@ static int qca8084_phy_package_probe_onc
 
 		if (of_node_name_eq(child, "pcs-phy")) {
 			mdiodev = qca8084_package_pcs_probe(child);
-			if (IS_ERR(mdiodev))
-				return PTR_ERR(mdiodev);
+			if (IS_ERR(mdiodev)) {
+				ret = PTR_ERR(mdiodev);
+				dev_err(&phydev->mdio.dev,
+					"BE7000 debug: QCA8084 PCS child probe failed ret=%pe\n",
+					ERR_PTR(ret));
+				return ret;
+			}
 
 			shared_priv->mdiodev[0] = mdiodev;
 		}
 
 		if (of_node_name_eq(child, "xpcs-phy")) {
 			mdiodev = qca8084_package_xpcs_probe(child);
-			if (IS_ERR(mdiodev))
-				return PTR_ERR(mdiodev);
+			if (IS_ERR(mdiodev)) {
+				ret = PTR_ERR(mdiodev);
+				dev_err(&phydev->mdio.dev,
+					"BE7000 debug: QCA8084 XPCS child probe failed ret=%pe\n",
+					ERR_PTR(ret));
+				return ret;
+			}
 
 			shared_priv->mdiodev[1] = mdiodev;
 		}
@@ -1330,7 +1340,15 @@ static int qca8084_phy_package_probe_onc
 				     "package reset not ready\n");
 
 	/* Deassert PHY package. */
-	return reset_control_deassert(rstc);
+	ret = reset_control_deassert(rstc);
+	if (ret)
+		return ret;
+
+	dev_info(&phydev->mdio.dev,
+		"BE7000 debug: QCA8084 package resources ready mode=%u phy-mdio=%d,%d,%d,%d pcs-mdio=%d xpcs-mdio=%d\n",
+		shared_priv->package_mode, addr[0], addr[1], addr[2], addr[3],
+		addr[4], addr[6]);
+	return 0;
 }
 
 static void qca8084_phy_package_remove_once(struct phy_device *phydev)
