#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

case "$DEVNAME" in ttyUSB[0-9]*) ;; *) exit 0 ;; esac
case "$DEVPATH" in
	*/fcd00000.usb/*/*-1/*-1:1.2/*) number=02; link=/dev/fm650-info ;;
	*/fcd00000.usb/*/*-1/*-1:1.3/*) number=03; link=/dev/fm650-at ;;
	*) exit 0 ;;
esac
. /lib/functions.sh
[ "$(board_name)" = 'bearkey,bq3588c' ] || exit 0

case "$ACTION" in
	add)
		iface="$(readlink -f "/sys/class/tty/$DEVNAME/device/..")"
		[ "$(cat "$iface/bInterfaceNumber" 2>/dev/null)" = "$number" ] || exit 0
		usb="${iface%/*}"
		[ "$(cat "$usb/idVendor" 2>/dev/null)" = 2cb7 ] || exit 0
		[ "$(cat "$usb/idProduct" 2>/dev/null)" = 0a05 ] || exit 0
		ln -sf "$DEVNAME" "$link" || exit 1
		;;
	remove)
		[ "$(readlink "$link")" != "$DEVNAME" ] || rm -f "$link"
		;;
	*) exit 0 ;;
esac

[ "$number" != 03 ] || /usr/libexec/bq3588c-fm650 refresh
