#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

[ -n "$INTERFACE" ] || exit 0
. /lib/functions.sh
[ "$(board_name)" = 'bearkey,bq3588c' ] || exit 0

if [ "$ACTION" = remove ] && [ "$INTERFACE" = fm650 ]; then
	/usr/libexec/bq3588c-fm650 refresh
	exit 0
fi

[ "$ACTION" = add ] || exit 0
iface="$(readlink -f "/sys/class/net/$INTERFACE/device")"
case "$iface" in
	/sys/devices/platform/fcd00000.usb/*/usb[0-9]*/*-1/*-1:1.*) ;;
	*) exit 0 ;;
esac
usb="${iface%/*}"
[ "$(cat "$usb/idVendor" 2>/dev/null)" = 2cb7 ] || exit 0
[ "$(cat "$usb/idProduct" 2>/dev/null)" = 0a05 ] || exit 0
[ "$(basename "$(readlink "$iface/driver")")" = cdc_ncm ] || exit 0

[ "$INTERFACE" = fm650 ] || ip link set dev "$INTERFACE" name fm650 || exit 1
/usr/libexec/bq3588c-fm650 refresh
